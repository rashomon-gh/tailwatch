[Unit]
Description=Network-aware Tailscale daemon
Documentation=https://github.com/yourusername/tailwatch
After=network-online.target
Wants=network-online.target
ConditionPathExists=/usr/local/bin/tailwatch

[Service]
Type=simple
ExecStart=/usr/local/bin/tailwatch
Restart=on-failure
RestartSec=5

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX

# D-Bus access for NetworkManager
AllowBus=org.freedesktop.NetworkManager

# Logging
StandardError=journal
StandardOutput=journal

[Install]
WantedBy=multi-user.target
